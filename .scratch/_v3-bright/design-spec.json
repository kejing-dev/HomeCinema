 "experience": {
  "subject": "A cinema frame that decorates around whatever video the user is already watching in another app (system player, PICO Video, browser): six contemporary 3D frame styles (Gallery, Neon Night, Washi & Wood, Holo Portal, Moss & Stone, Cosmos), each with its own theme lights and ambience, with show lighting that follows the sound and a sleep timer. It does not play video, dim the room or control other apps.",
  "form": "Shared Space only. A hollow 3D Volume (one of six real 3D frame styles) plus a small Planar controls window to its right. No Stage, because Stage forces Full Space, which hides other apps and stops their playback (verified on emulator, see feasibility.md)."
 },
 "theme": {
  "brandColors": {}
 },
 "surfaces": [
  {
   "id": "frame-volume",
   "type": "volume",
   "defaultSize": {
    "width": 2550,
    "height": 1500,
    "depth": 450,
    "unit": "dp"
   },
   "rootNodeId": "vol-root",
   "purpose": "Main window. Transparent (no material background, base panel hidden), uniform resize only so the 16:9 opening keeps its shape. The user aligns it around the other app's player window by hand; Home Cinema cannot read other windows' poses. No recenter or bring-to-front promise."
  },
  {
   "id": "controls-window",
   "type": "planar",
   "defaultSize": {
    "width": 480,
    "height": 720,
    "unit": "dp"
   },
   "rootNodeId": "ctl-root",
   "windowBackground": "material",
   "ownerSurfaceId": "frame-volume",
   "initiallyVisible": true,
   "placement": {
    "side": "end",
    "align": "bottom",
    "gapDp": 60,
    "depthDp": 0
   },
   "purpose": "Controls beside the frame (Placement.right of the Volume); never over the opening."
  }
 ],
 "initialStateId": "lights-up",
 "states": [
  {
   "id": "lights-up",
   "surfaceRoots": {
    "frame-volume": "vol-root",
    "controls-window": "ctl-root"
   },
   "values": {
    "style": "gallery",
    "showState": "up",
    "alignMode": "off",
    "panelPage": "Show",
    "autoShow": true,
    "sleepTimer": "Off",
    "ambience": false,
    "language": "Follow system"
   }
  },
  {
   "id": "first-launch-align",
   "surfaceRoots": {
    "frame-volume": "vol-root",
    "controls-window": "ctl-root"
   },
   "values": {
    "alignMode": "on"
   },
   "note": "Shown automatically on first launch, then only from Align frame to player"
  },
  {
   "id": "showing",
   "surfaceRoots": {
    "frame-volume": "vol-root",
    "controls-window": "ctl-root"
   },
   "values": {
    "showState": "showing"
   }
  },
  {
   "id": "settings",
   "surfaceRoots": {
    "frame-volume": "vol-root",
    "controls-window": "ctl-root"
   },
   "values": {
    "panelPage": "Settings"
   }
  }
 ],
 "actions": [
  {
   "id": "choose-style",
   "purpose": "Loads the selected style's GLB (Gallery, Neon Night, Washi & Wood, Holo Portal, Moss & Stone, Cosmos) into the Volume with a 1.2 s cross-fade, switches its theme lights (emit_* materials) and ambience loop, updates the style line; remembered across launches."
  },
  {
   "id": "toggle-show",
   "purpose": "Manual fallback. Start the show: Opening (theme lights fade to 12 % over 4 s, ambience fades in) then Showing. End the show: Closing (theme lights back to 100 % over 6 s, ambience fades out) then Lights up. Only our own frame lights change; the room is not dimmed."
  },
  {
   "id": "toggle-auto-show",
   "purpose": "When on (default), polls AudioManager.isMusicActive every 1 s: inactive to active starts the show; 8 s of continuous inactivity ends it. A manual press overrides auto until the next state change from sound."
  },
  {
   "id": "enter-align-mode",
   "purpose": "Shows the alignment outline and the align panel; the system window handles of the Volume are highlighted; theme lights stay up so the opening is easy to see."
  },
  {
   "id": "leave-align-mode",
   "purpose": "Hides the alignment aids. The Volume keeps the size and position the user set (the system restores it on next launch where supported)."
  },
  {
   "id": "set-sleep-timer",
   "purpose": "Off / 60 / 90 / 120 min. On expiry runs End the show and stops ambience; it never pauses or closes the other app. A small remaining-time line appears under the status text while active."
  },
  {
   "id": "toggle-ambience",
   "purpose": "Plays the selected style's looped ambience during Opening and Showing only; off by default."
  },
  {
   "id": "set-ambience-volume",
   "purpose": "Sets ambience volume 0-1 (default 0.3)."
  },
  {
   "id": "switch-panel-page",
   "purpose": "Shows the Show or Settings page in the controls window."
  },
  {
   "id": "open-language-menu",
   "purpose": "Opens the language menu anchored to the language button."
  },
  {
   "id": "choose-language",
   "purpose": "Applies Follow system / Simplified Chinese / English to all strings immediately and persists it."
  },
  {
   "id": "exit-app",
   "purpose": "Finishes the activity and closes the frame Volume and the controls window."
  }
 ],
