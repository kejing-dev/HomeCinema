   "id": "frame-model",
   "kind": "domain_visual",
   "rendererKey": "frame-style-model",
   "purpose": "3D model: The selected frame style as one 3D model (GLB, metres) filling the Volume around a 1.6 x 0.9 m hollow 16:9 opening; six styles: Gallery, Neon Night, Washi & Wood, Holo Portal, Moss & Stone, Cosmos",
   "layout": {
    "sizing": "matchParent",
    "modelExtentM": [
     3.4,
     2.0,
     0.6
    ],
    "openingM": [
     1.6,
     0.9
    ],
    "dpPerModelMetre": 750
   },
   "assetId": "frame-gallery",
   "bindings": {
    "assetId": "frame-<style> (gallery | neon | wa | portal | moss | cosmos)",
    "showState": "showState",
    "alignMode": "alignMode"
   },
   "designNotes": {
    "represents": "The selected frame style as one 3D model (GLB, metres) filling the Volume around a 1.6 x 0.9 m hollow 16:9 opening; six styles: Gallery, Neon Night, Washi & Wood, Holo Portal, Moss & Stone, Cosmos",
    "previewRepresentation": "Transparent orthographic renders of the actual GLB (lights-up and showing variants), cross-faded by show state",
    "assetStatus": "available",
    "assetId": "frame-gallery",
    "appearance": [
     "Gallery: deep matte-plaster box frame with a warm LED reveal, floating oak shelf with a terracotta vase and a brass knot",
     "Neon Night: gunmetal frame with magenta outer and cyan inner neon tubes, amber corner slashes, cyan floor line",
     "Washi & Wood: hinoki posts and beams, glowing shoji panels on both sides, a round paper lantern",
     "Holo Portal: three floating emissive rounded rings (cyan, violet, blue), glass halo, light nodes, hovering base puck",
     "Moss & Stone: stacked natural stone slabs, moss cushions and fern fronds",
     "Cosmos: deep-navy frame, star field, ringed planet, orbit line and a small moon"
    ],
    "behaviors": [
     "Opening is hollow with no geometry and no collider, so rays reach the other app's window behind it",
     "Every mesh whose material name starts with emit_ is a theme light: its emissive intensity follows the show state (Lights up 100 %, Opening 60 %->, Showing 12 %, Closing back over 6 s)",
     "Switching style cross-fades over 1.2 s and switches the ambience loop; the choice is remembered",
     "Uniform resize only; the model is scaled to the Volume (750 dp per model metre at the default size)"
    ],
    "previewLimitations": [
     "Renders are lit by a neutral room environment; on device the passthrough room is not dimmed",
     "Bloom on emissive tubes is a render effect; on device glow depends on runtime post-processing support"
    ]
   },
   "children": [
    "align-outline"
   ]
  },
